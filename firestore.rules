rules_version = '2';
// Anyone with the link can read and score. Only the collections the scoreboard uses are open:
// event, players and matches for the scores, media for the Photos tab.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{coll}/{id} {
      allow read, write: if coll in ['event', 'players', 'matches', 'media'];
    }
  }
}
